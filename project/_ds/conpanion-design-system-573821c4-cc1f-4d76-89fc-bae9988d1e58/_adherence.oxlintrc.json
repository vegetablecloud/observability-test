{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/slides/**",
              "slides/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Roboto Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Roboto Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|level|style|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, level, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|href|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, href, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|heading|eyebrow|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: accent, heading, eyebrow, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:lines|style|key|ref|className|style|children)$/]",
        "message": "<ContactBlock> doesn't accept that prop. Declared props: lines, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rule|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: rule, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconAlt|heading|body|width|base|style|key|ref|className|style|children)$/]",
        "message": "<IconCard> doesn't accept that prop. Declared props: icon, iconAlt, heading, body, width, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|height|style|key|ref|className|style|children)$/]",
        "message": "<KeyMark> doesn't accept that prop. Declared props: color, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyMark'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:yellow|black|white)$/]",
        "message": "<KeyMark> color must be one of 'yellow' | 'black' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyPhoto'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|height|focus|style|key|ref|className|style|children)$/]",
        "message": "<KeyPhoto> doesn't accept that prop. Declared props: src, height, focus, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyPhoto'] > JSXAttribute[name.name='focus'] > Literal[value!=/^(?:xMidYMin|xMidYMid|xMidYMax)$/]",
        "message": "<KeyPhoto> focus must be one of 'xMidYMin' | 'xMidYMid' | 'xMidYMax'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|base|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, width, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|wordmark|onYellow)$/]",
        "message": "<Logo> variant must be one of 'lockup' | 'wordmark' | 'onYellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:ground|footerBar|mark|children|style|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: ground, footerBar, mark, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='ground'] > Literal[value!=/^(?:paper|yellow|dark)$/]",
        "message": "<SlideFrame> ground must be one of 'paper' | 'yellow' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|x|y|width|size|color|style|key|ref|className|style|children)$/]",
        "message": "<SlideTitle> doesn't accept that prop. Declared props: children, x, y, width, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|dark)$/]",
        "message": "<Tag> tone must be one of 'default' | 'accent' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TechLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|height|base|style|key|ref|className|style|children)$/]",
        "message": "<TechLogo> doesn't accept that prop. Declared props: name, height, base, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],

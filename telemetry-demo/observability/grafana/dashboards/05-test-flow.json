      ],
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {},
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 16
      }
    },
    {
      "type": "logs",
      "title": "Loggarna för anropet · i tidsordning, alla tjänster",
      "description": "Berättelsen i text: request_started (frontend) → node_done … tool_done … (ai-chat) → search_done (rag-api) → ask_completed (backend) → response_sent.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{deployment_environment_name=\"demo\"} | trace_id=\"$trace_id\"",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "range",
          "direction": "forward"
        }
      ],
      "datasource": {
        "type": "loki",

    {
      "type": "traces",
      "title": "Waterfall · $trace_id",
      "description": "Samma steg som tabellen, som waterfall. Klicka på en span för alla attribut och 'Logs for this span'.",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "$trace_id",
          "limit": 20,
          "filters": []

    {
      "id": 5,
      "type": "row",
      "title": "③ Ett anrop A→Ö · $trace_id",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Stegen i tidsordning",
      "description": "Varje span i anropet, i den ordning de startade: frontend → backend → ai-chat (noderna, LLM, verktygen) → rag-api → databaser. Stapeln visar hur lång tid steget tog. Gult = steget felade.",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ trace:id = \"$trace_id\" && name != \"\" } | select(resource.service.name, span.langgraph.node, span.gen_ai.tool.name, status, span.error.type)",
          "limit": 1,
          "tableType": "spans",
          "spss": 100,
          "filters": []
        }
      ],
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "links": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tid"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",

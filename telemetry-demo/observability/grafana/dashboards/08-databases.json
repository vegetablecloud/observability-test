    {
      "type": "stat",
      "title": "Cache-träff",
      "description": "Andel block som lästs från minnet i stället för disk. Under 95 %: shared_buffers räcker inte.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name) (rate(postgresql_blks_hit_total{service_name=~\"$db\"}[5m])) / (sum by (service_name) (rate(postgresql_blks_hit_total{service_name=~\"$db\"}[5m])) + sum by (service_name) (rate(postgresql_blks_read_total{service_name=~\"$db\"}[5m])))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,

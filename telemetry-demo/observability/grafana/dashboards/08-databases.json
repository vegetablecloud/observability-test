    {
      "type": "table",
      "title": "Långsamma DB-frågor (> 100 ms) · klicka för trace",
      "description": "Varje DB-anrop som tog mer än 100 ms, med SQL-texten. Prova chaos-läget db_slow.",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ kind = client && (span.db.system = \"postgresql\" || span.db.system.name = \"postgresql\") && duration > 100ms } | select(resource.service.name, span.db.statement, span.db.query.text)",
          "limit": 20,
          "tableType": "spans",
          "spss": 3,
          "filters": []

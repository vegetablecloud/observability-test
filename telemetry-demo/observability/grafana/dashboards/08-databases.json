    {
      "type": "timeseries",
      "title": "DB-frågor p95 · backend (Npgsql) och algorithm/rag-api (psycopg)",
      "description": "Latensen apparna ser, inklusive nätverk och connection pool. Stiger den men inte ① inifrån: problemet är mellan app och DB.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(db_client_operation_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "exemplar": false,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_CLIENT\", span_name=~\"SELECT.*|INSERT.*\"}[1m])))",
          "legendFormat": "{{service}} (ur traces)",
          "range": true,
          "instant": false,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": true,
            "axisBorderShow": false,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "backend"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFFFFF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rag-api (ur traces)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFB400"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "algorithm (ur traces)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#707070"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "backend (ur traces)"
            },
            "properties": [
              {
                "id": "color",

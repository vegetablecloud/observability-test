    {
      "type": "stat",
      "title": "KV-cache · gemma",
      "description": "Hur full KV-cachen är. Nära 100 %: vLLM måste pausa (preempt) requests, latensen hoppar.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * max({\"vllm:kv_cache_usage_perc\", model_name=\"gemma\"})",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#FFFFFF"
              },
              {
                "value": 85,
                "color": "#FFB400"
              }
            ]
          },
          "links": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",

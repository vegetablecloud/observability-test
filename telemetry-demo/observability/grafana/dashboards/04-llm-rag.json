      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate({\"vllm:time_to_first_token_seconds_bucket\", model_name=~\"$model\"}[1m])))",
          "legendFormat": "TTFT · {{model_name}}",
          "range": true,
          "instant": false,
          "exemplar": false,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate({\"vllm:e2e_request_latency_seconds_bucket\", model_name=~\"$model\"}[1m])))",
          "legendFormat": "e2e · {{model_name}}",

    {
      "type": "heatmap",
      "title": "gemma · e2e-latens, fördelning",
      "description": "Varje kolumn = en minut. Ljusare ruta = fler requests med den latensen. Två band = två sorters requests (välja verktyg vs skriva svar).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (le) (increase({\"vllm:e2e_request_latency_seconds_bucket\", model_name=\"gemma\"}[1m]))",

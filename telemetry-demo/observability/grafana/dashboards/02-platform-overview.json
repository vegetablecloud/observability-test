    {
      "id": 37,
      "type": "table",
      "title": "Långsamma requests (> 1 s) · klicka för trace",
      "description": "TRACES svarar på: var händer det? Öppna en trace och se vilken span som tar tiden.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{ resource.service.name = \"frontend\" && kind = server && duration > 1s }"

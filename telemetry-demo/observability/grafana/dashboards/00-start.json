    {
      "type": "stat",
      "title": "AI-modeller & databaser · hämtas (pull)",
      "description": "vLLM: NERE om /metrics inte svarar, STÖRD om time-to-first-token p95 > 1 s eller kön > 4. Databaser: NERE om Collectorn slutat få statistik.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (komponent) (label_replace(clamp_max(2 * (1 - max by (job) (up{job=~\"vllm-.*\"})) + (((histogram_quantile(0.95, sum by (le, job) (rate({\"vllm:time_to_first_token_seconds_bucket\"}[2m]))) > bool 1) or on (job) max by (job) (sum by (job) ({\"vllm:num_requests_waiting\"}) > bool 4)) or on (job) (0 * max by (job) (up{job=~\"vllm-.*\"}))), 2), \"komponent\", \"$1\", \"job\", \"(.*)\")) or max by (komponent) (label_replace(0 * max by (service_name) (postgresql_backends), \"komponent\", \"$1\", \"service_name\", \"(.*)\")) or max by (komponent) (label_replace(2 * max by (service_name) (max_over_time(postgresql_backends[1h]) >= 0), \"komponent\", \"$1\", \"service_name\", \"(.*)\"))",
          "legendFormat": "{{komponent}}",
          "range": false,
          "instant": true,
          "exemplar": false,
          "editorMode": "code"

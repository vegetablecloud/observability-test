    {
      "type": "stat",
      "title": "Applikationen · pushar telemetri",
      "description": "Felkvot per tjänst ur traces: > 2 % = STÖRD, > 50 % = NERE. En tjänst som varit aktiv senaste timmen men tystnat i 2 minuter visas som NERE.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (komponent) (label_replace((((sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[2m])) or sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[2m])) * 0) / sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[2m]))) > bool 0.02) + (((sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[2m])) or sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[2m])) * 0) / sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[2m]))) > bool 0.50), \"komponent\", \"$1\", \"service\", \"(.*)\")) or max by (komponent) (label_replace(2 * group by (service_name) (max_over_time(target_info{service_name=~\"frontend|backend|ai-chat|rag-api|algorithm\"}[1h])), \"komponent\", \"$1\", \"service_name\", \"(.*)\"))",
          "legendFormat": "{{komponent}}",
          "range": false,
          "instant": true,
          "exemplar": false,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,

        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(max by (container_label_com_docker_compose_service) (time() - container_last_seen{container_label_com_docker_compose_service!=\"\"} < bool 30))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "exemplar": false,
          "editorMode": "code"

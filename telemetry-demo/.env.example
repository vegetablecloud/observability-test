# Kopiera till .env och justera: cp .env.example .env

# sim = mock-LLM + simulerad GPU (körs överallt)   gpu = riktig vLLM + dcgm-exporter (DGX Spark)
COMPOSE_PROFILES=sim
# Andel "vanliga" traces som behålls (fel och långsamma behålls alltid). Prova 10.
TRACE_SAMPLING_PERCENT=100
# Frågor per sekund från loadgen
RPS=2
# true = backend lägger user_id/request_id som metric-labels (visar cardinality-explosion)
BAD_CARDINALITY=false
# Timeout per LLM-anrop i ai-chat (sekunder)
LLM_TIMEOUT_S=2.5
GRAFANA_PUBLIC_URL=http://localhost:3000
# Endast gpu-profilen: token för gated Hugging Face-modeller (lämna tom annars)
HF_TOKEN=
